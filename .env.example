# =============================================================================
# Run tests (required to clone and run Playwright)
# =============================================================================

# Base URL of the Didaxis environment under test (Playwright use.baseURL).
DIDAXIS_URL=https://test.example.com

# Primary account email used by auth.setup.ts to build storageState.
DIDAXIS_EMAIL=you@example.com

# Primary account password for UI login during setup.
DIDAXIS_PASSWORD=replace-me

# Bearer token for Programs API cleanup and API assertions (Authorization: Bearer …).
DIDAXIS_API_TOKEN=replace-me-api-token

# Optional: secondary account email for permission / role probe specs.
DIDAXIS_ALT_EMAIL=alt@example.com

# Optional: secondary account password for permission / role probe specs.
DIDAXIS_ALT_PASSWORD=replace-me-alt

# =============================================================================
# Agent / CI setup (not needed for `npx playwright test` alone)
# Headless agent: .github/workflows/test-generation.yml
# MCP / Atlassian access: also configure tokens in Cursor settings
# =============================================================================

# Cursor API key for the headless `agent` CLI in CI.
CURSOR_API_KEY=replace-me-cursor-api-key

# Atlassian API token for Jira (bug reporter / ticket analysis via MCP or CI).
ATLASSIAN_API_TOKEN=replace-me-atlassian-api-token

# Atlassian Cloud site URL (e.g. https://your-org.atlassian.net).
ATLASSIAN_BASE_URL=https://your-org.atlassian.net

# Atlassian account email paired with ATLASSIAN_API_TOKEN.
ATLASSIAN_EMAIL=you@example.com
