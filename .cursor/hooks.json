{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/guard-constitution-wont.js",
        "matcher": "Write",
        "failClosed": true
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/remind-eval-report.js",
        "loop_limit": 1
      }
    ]
  }
}
